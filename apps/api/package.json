{
  "name": "@weft/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@weft/core": "workspace:*",
    "@weft/i18n": "workspace:*",
    "@weft/infra-db": "workspace:*",
    "@weft/infra-jobs": "workspace:*",
    "@weft/infra-storage": "workspace:*",
    "better-auth": "^1.7.10",
    "hono": "^4.13.13",
    "pg-boss": "^12.38.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15"
  }
}
