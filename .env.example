# Copy to .env and adjust. Never commit .env.
DATABASE_URL=postgres://weft:weft@localhost:5432/weft
# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=change-me-to-a-random-string-of-at-least-32-chars
PUBLIC_URL=http://localhost:3000
# false: only the first account (the admin) and people with a pending invitation can sign up.
OPEN_SIGNUP=true
# Proxies that add to X-Forwarded-For in front of the API: 1 for the bundled web app, 2 if a
# reverse proxy (Caddy, nginx, Traefik) sits in front of it. Used for rate limits.
TRUSTED_PROXY_HOPS=1
API_INTERNAL_URL=http://localhost:4000

# Object storage (SeaweedFS in docker compose; any S3-compatible service works).
S3_ACCESS_KEY_ID=weft
# Generate with: openssl rand -hex 24
S3_SECRET_ACCESS_KEY=change-me
# URL browsers use to reach the storage (presigned uploads and playback).
STORAGE_PUBLIC_URL=http://localhost:8333

# Render worker: renders processed at once (each can use every CPU core).
RENDER_CONCURRENCY=1
# Speech recognition model for transcripts: tiny, base, small or medium.
WHISPER_MODEL=base
TRANSCRIBE_CONCURRENCY=1

# Email notifications (comments, replies, invitations). Leave empty to disable.
# For local testing: `docker compose --profile mail up` and SMTP_URL=smtp://mailpit:1025
SMTP_URL=
MAIL_FROM=Weft <weft@localhost>
