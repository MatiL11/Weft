{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {},
    "test": {},
    "test:coverage": {
      "outputs": ["coverage/**"]
    }
  },
  "globalPassThroughEnv": [
    "CHROMIUM_PATH",
    "WHISPER_CLI_PATH",
    "WHISPER_MODEL_PATH",
    "WHISPER_SAMPLE_WAV"
  ]
}
